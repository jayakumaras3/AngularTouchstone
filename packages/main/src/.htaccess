<IfModule mod_rewrite.c>
  RewriteEngine On
  # No hardcoded RewriteBase: this build is deployed at different sub-paths
  # (e.g. dochek.com/ang/ in production, /DOCHEK/ang/ on staging). Apache
  # auto-detects the base from this file's own location when none is set,
  # which keeps the same build working correctly at either path.

  # Don't rewrite files or directories that exist
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Don't rewrite API requests - let them hit the backend
  RewriteCond %{REQUEST_URI} ^/DOCHEK/app/ [OR]
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteRule ^ - [L]

  # Rewrite everything else to index.html for SPA routing
  RewriteRule ^ index.html [L]
</IfModule>
